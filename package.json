{
  "name": "blackgate-ai-game",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Blackgate II: a partially observed, adaptive, long-horizon decision benchmark with an independent authoritative referee.",
  "scripts": {
    "start": "node v2/server.mjs",
    "agent:example": "node examples/minimal-agent.mjs",
    "check": "node scripts/check.mjs",
    "start:v2": "node v2/server.mjs",
    "start:classic": "node runner/server.mjs",
    "test": "node --test --test-concurrency=1 v2/tests/*.test.mjs",
    "test:browser": "node v2/scripts/browser-smoke.mjs",
    "balance": "node v2/scripts/balance.mjs",
    "corpus": "node v2/scripts/build-corpus.mjs",
    "replay": "node v2/scripts/replay.mjs",
    "build:pages": "node scripts/prepare-pages.mjs",
    "start:gateway": "node gateway/server.mjs"
  },
  "dependencies": {
    "playwright": "^1.55.0"
  }
}
